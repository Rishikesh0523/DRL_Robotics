<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="env1_4x4_circles">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== BOUNDARY WALLS (4 × 4 m arena) ========== -->
    <!-- north -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.2 0.1 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.2 0.1 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- south -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.2 0.1 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.2 0.1 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- east -->
    <model name="wall_east">
      <static>true</static>
      <pose>4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- west -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== 4 ASYMMETRIC, CLEAR-CORRIDOR PILLARS ========== -->
<!-- 1  top-left   (shifted right & down)   -->
<model name="pillar_1">
  <static>true</static>
  <pose>-1.0 1.5 0.75 0 0 0</pose>
  <link name="link">
    <collision name="collision"><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry></collision>
    <visual    name="visual"   ><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry>
               <material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
  </link>
</model>                      

<!-- 2  top-right   (shifted left & down)   -->
<model name="pillar_2">
  <static>true</static>
  <pose> 1.3 1.0 0.75 0 0 0</pose>
  <link name="link">
    <collision name="collision"><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry></collision>
    <visual    name="visual"   ><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry>
               <material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
  </link>
</model>               

<!-- 3  bottom-left   (shifted right & up)   -->
<model name="pillar_3">
  <static>true</static>
  <pose>-1.4 -0.8 0.75 0 0 0</pose>
  <link name="link">
    <collision name="collision"><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry></collision>
    <visual    name="visual"   ><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry>
               <material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
  </link>
</model>                     

<!-- 4  bottom-right   (shifted left & up)   -->
<model name="pillar_4">
  <static>true</static>
  <pose> 0.8 -1.6 0.75 0 0 0</pose>
  <link name="link">
    <collision name="collision"><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry></collision>
    <visual    name="visual"   ><geometry><cylinder><radius>0.20</radius><length>1.5</length></cylinder></geometry>
               <material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
  </link>
</model>    
  </world>
</sdf>