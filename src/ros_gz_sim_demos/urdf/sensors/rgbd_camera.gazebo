<?xml version="1.0"?>
<robot>
  <gazebo reference="rgbd_camera_link_optical">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.5185</horizontal_fov>
        <image>
          <width>424</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.03</near>
          <far>15</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>2</update_rate>
      <visualize>true</visualize>
      <topic>rgbd</topic>
    </sensor>
  </gazebo>
</robot>