<?xml version="1.0"?>
<robot>
  <gazebo>
    <plugin
      filename="gz-sim-mecanum-drive-system"
      name="gz::sim::systems::MecanumDrive">
      <topic>cmd_vel</topic>

      <!-- Wheel joints (case-sensitive!) -->
      <front_left_joint>FL_wheel_joint</front_left_joint>
      <front_right_joint>FR_wheel_joint</front_right_joint>
      <back_left_joint>RL_wheel_joint</back_left_joint>
      <back_right_joint>RR_wheel_joint</back_right_joint>

      <!-- Wheel parameters -->
      <wheel_separation>0.174</wheel_separation>
      <wheelbase>0.154</wheelbase>
      <wheel_radius>0.048</wheel_radius>

      <!-- Optional tuning -->
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>

      <!-- Odometry settings -->
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin name="gz::sim::systems::OdometryPublisher"
            filename="gz-sim-odometry-publisher-system">
      <odom_topic>odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_tf>true</publish_tf>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>

    <plugin name="gz::sim::systems::JointStatePublisher"
            filename="gz-sim-joint-state-publisher-system">
      <topic>joint_states</topic>
      <joint_name>FL_wheel_joint</joint_name>
      <joint_name>FR_wheel_joint</joint_name>
      <joint_name>RL_wheel_joint</joint_name>
      <joint_name>RR_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link_optical">
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <!-- Noise is sampled independently per pixel on each frame.
               That pixel's noise value is added to each of its color
               channels, which at that point lie in the range [0,1]. -->
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <optical_frame_id>camera_link_optical</optical_frame_id>
        <camera_info_topic>camera/camera_info</camera_info_topic>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera/image</topic>
    </sensor>
  </gazebo>

</robot>
